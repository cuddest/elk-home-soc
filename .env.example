# Elastic Stack version. Keep all Elastic components on the same version.
STACK_VERSION=9.4.4

# Local-only passwords. Use different values in your real environment.
ELASTIC_PASSWORD=ElasticLab2026
KIBANA_SYSTEM_PASSWORD=KibanaLab2026
LOGSTASH_PASSWORD=LogstashLab2026

# Hostname/IP that real Filebeat/Winlogbeat endpoints will use to reach Logstash.
# For local-only operation keep localhost. For a LAN lab, set this to the ELK host DNS name/IP
# and regenerate certificates with ./scripts/bootstrap-certs.sh after deleting certs/.
LOGSTASH_HOSTNAME=localhost
LOGSTASH_BEATS_BIND=127.0.0.1
LOGSTASH_BEATS_PORT=5044

ES_PORT=9200
KIBANA_PORT=5601
NGINX_PORT=8080
